SHOPIFY_API_KEY=
SHOPIFY_PASSWORD=
SHOPIFY_SHOP_NAME=

# Production deployment
# Example: https://www.yourdomain.com,https://your-project.pages.dev
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a long random value in production and use the same value as VITE_API_TOKEN in the frontend.
API_TOKEN=

RAKUTEN_API_KEY=
RAKUTEN_SHOP_ID=
RAKUTEN_BASE_URL=
FEISHU_RAKUTEN_WIKI_NODE_TOKEN=
FEISHU_RAKUTEN_BITABLE_APP_TOKEN=
FEISHU_RAKUTEN_ORDER_TABLE_ID=
# Optional. Comma-separated RMS monthly store sales used to correct annual/monthly actuals.
# Example: RAKUTEN_RMS_MONTHLY_SALES_2026=1=9274685,2=9912007,3=13486216
RAKUTEN_RMS_MONTHLY_SALES_2026=

# tomtoc Rakuten 店铺示例：前端显示 tomtoc，store_id = "store2"
RAKUTEN_STORE2_API_KEY=
RAKUTEN_STORE2_SHOP_ID=
RAKUTEN_STORE2_BASE_URL=https://api.rms.rakuten.co.jp
FEISHU_RAKUTEN_STORE2_WIKI_NODE_TOKEN=
FEISHU_RAKUTEN_STORE2_BITABLE_APP_TOKEN=
FEISHU_RAKUTEN_STORE2_ORDER_TABLE_ID=
FEISHU_RAKUTEN_TOMTOC_WEEKLY_WIKI_NODE_TOKEN=
FEISHU_RAKUTEN_TOMTOC_WEEKLY_SHEET_ID=
FEISHU_DASHBOARD_SPREADSHEET_TOKEN=
FEISHU_DASHBOARD_EZLIFE_APP_TOKEN=
FEISHU_DASHBOARD_TOMTOC_APP_TOKEN=
FEISHU_TOMTOC_DASHBOARD_SPREADSHEET_TOKEN=
FEISHU_TOMTOC_DASHBOARD_SHEET_ID=
FEISHU_YAHOO_WIKI_NODE_TOKEN=

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

FEISHU_BOT_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_DEFAULT_USER_OPEN_ID=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Amazon 排名同步到飞书电子表格（Sheet）
FEISHU_SHEET_TOKEN=   # 电子表格 URL 中 /sheets/ 后面的 token（rank_sync 用）
FEISHU_SHEET_NAME=    # 可选：不填就按“2月/3月...”
MAX_ROWS=200

# Amazon 关键词追踪（独立 Sheet）
FEISHU_KEYWORD_SHEET_TOKEN=   # keyword_tracker 用，单独的关键词追踪表 token
FEISHU_KEYWORD_SHEET_NAME=KW追踪
AMZ_KEYWORD_MAX_PAGES=3
